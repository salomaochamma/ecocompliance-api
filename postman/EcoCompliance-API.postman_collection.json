{
  "info": {
    "name": "EcoCompliance API",
    "description": "Coleo de endpoints do EcoCompliance API - ESG: Governana e Compliance Ambiental",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "ecocompliance-collection-001"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (Admin)",
          "request": {
            "method": "POST",
            "auth": {"type": "noauth"},
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Novo Admin\",\n  \"email\": \"novoadmin@ecocompliance.com\",\n  \"senha\": \"admin123\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {"type": "noauth"},
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ecocompliance.com\",\n  \"senha\": \"admin123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login (User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {"type": "noauth"},
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@ecocompliance.com\",\n  \"senha\": \"user123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Empresas",
      "item": [
        {
          "name": "Listar empresas",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/empresas"
          }
        },
        {
          "name": "Buscar empresa por ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/empresas/1"
          }
        },
        {
          "name": "Criar empresa",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Nova Empresa Verde Ltda\",\n  \"cnpj\": \"99.888.777/0001-66\",\n  \"setor\": \"Tecnologia\",\n  \"emailResponsavel\": \"esg@novaempresa.com.br\"\n}"
            },
            "url": "{{baseUrl}}/empresas"
          }
        },
        {
          "name": "Atualizar empresa",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Verde Indstria Atualizada S.A.\",\n  \"cnpj\": \"12.345.678/0001-90\",\n  \"setor\": \"Manufatura Sustentvel\",\n  \"emailResponsavel\": \"sustentabilidade@verdeindustria.com.br\"\n}"
            },
            "url": "{{baseUrl}}/empresas/1"
          }
        },
        {
          "name": "Excluir empresa",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/empresas/4"
          }
        }
      ]
    },
