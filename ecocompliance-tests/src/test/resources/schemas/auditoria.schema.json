{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "AuditoriaResponseDTO",
  "description": "Contrato de um item retornado por GET/POST/PUT /auditorias",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "empresaId",
    "empresaNome",
    "dataAuditoria",
    "resultado",
    "observacoes",
    "nivelRisco"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "empresaId": {
      "type": "integer",
      "minimum": 1
    },
    "empresaNome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150
    },
    "dataAuditoria": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "resultado": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "observacoes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000
    },
    "nivelRisco": {
      "type": "string",
      "enum": [
        "BAIXO",
        "MEDIO",
        "ALTO"
      ]
    }
  }
}
