{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "RelatorioEmpresaDTO",
  "description": "Contrato do relatório ESG consolidado (GET /relatorios/empresa/{empresaId})",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "empresa",
    "totalEmissoesCarbono",
    "totalCarbonoCompensado",
    "quantidadeLicencasAtivas",
    "quantidadeLicencasVencidas",
    "quantidadeAuditorias",
    "maiorNivelRisco"
  ],
  "properties": {
    "empresa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nome",
        "cnpj",
        "setor",
        "emailResponsavel",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "nome": {
          "type": "string",
          "minLength": 2,
          "maxLength": 150
        },
        "cnpj": {
          "type": "string",
          "pattern": "^([0-9]{2}\\.[0-9]{3}\\.[0-9]{3}/[0-9]{4}-[0-9]{2}|[0-9]{14})$"
        },
        "setor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "emailResponsavel": {
          "type": "string",
          "minLength": 3,
          "maxLength": 150,
          "pattern": "^[^@\\s]+@[^@\\s]+$"
        },
        "createdAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]{1,9})?)?$"
        }
      }
    },
    "totalEmissoesCarbono": {
      "type": "number",
      "minimum": 0
    },
    "totalCarbonoCompensado": {
      "type": "number",
      "minimum": 0
    },
    "quantidadeLicencasAtivas": {
      "type": "integer",
      "minimum": 0
    },
    "quantidadeLicencasVencidas": {
      "type": "integer",
      "minimum": 0
    },
    "quantidadeAuditorias": {
      "type": "integer",
      "minimum": 0
    },
    "maiorNivelRisco": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "BAIXO",
        "MEDIO",
        "ALTO",
        null
      ]
    }
  }
}
